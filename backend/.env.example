# Backend settings. Copy to .env (git-ignored) and fill in the secrets:
#   cp .env.example .env
# Values must match the root .env used by docker-compose.yml.

# ── Application ──
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
SQL_ECHO=false                 # true prints every SQL statement (dev debugging)

# ── Database (async driver: postgresql+asyncpg://) ──
DATABASE_URL=postgresql+asyncpg://taskapp:CHANGE_ME@127.0.0.1:5433/task_management
TEST_DATABASE_URL=postgresql+asyncpg://taskapp:CHANGE_ME@127.0.0.1:5433/task_management_test

# How asyncpg is used:
# Your service or repository calls SQLAlchemy, for example:
#   session.execute(select(Task).where(...))
# SQLAlchemy builds the SQL and maps returned rows to Python objects such as
# Task or User. It uses asyncpg as the PostgreSQL driver.
# asyncpg gets a connection from SQLAlchemy's pool and sends the SQL to
# PostgreSQL over TCP, using the host and port in the database URL.
# PostgreSQL runs the query and returns rows through asyncpg to SQLAlchemy.
# Flow: application -> SQLAlchemy -> asyncpg -> PostgreSQL -> results back

# ── Connection pool (per Uvicorn worker process) ──
DB_POOL_SIZE=10                # connections kept open
DB_MAX_OVERFLOW=10             # extra connections allowed during bursts
DB_POOL_TIMEOUT=30             # seconds to wait for a free connection before erroring
DB_POOL_RECYCLE=1800           # replace connections older than 30 min
# Example: when Alice creates a task, the backend borrows a connection to save
# it, then returns it to the shared pool. Bob's request to view tasks can reuse
# that connection later; connections are shared by all users, not reserved.
# This worker can use 10 pooled connections plus up to 10 temporary overflow
# connections. If all are busy, another database request waits up to 30 seconds.

# ── Auth tokens (docs/api.md section 2, A-10, A-11) ──
JWT_SECRET_KEY=CHANGE_ME_RUN_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_REUSE_GRACE_SECONDS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# JWT_SECRET_KEY signs tokens, and JWT_ALGORITHM selects the signing method.
# Access tokens expire after 15 minutes; a valid refresh token can request a
# new access token for up to 14 days. Password-reset tokens are separate and
# expire after 30 minutes.

# ── Links and email (A-3) ──
FRONTEND_BASE_URL=http://localhost:3000   # used to build reset / set-password links
EMAIL_BACKEND=console                     # console = write the link to the server log

# Configuration notes:
# - Application: APP_ENV selects development, test, or production behavior.
#   LOG_LEVEL controls logging detail. SQL_ECHO=true logs SQL queries.
# - Database: DATABASE_URL connects to the development database;
#   TEST_DATABASE_URL is for tests. Their port must match the port exposed by
#   Docker Compose.
# - Connection pool: DB_POOL_SIZE and DB_MAX_OVERFLOW control the number of
#   database connections; DB_POOL_TIMEOUT and DB_POOL_RECYCLE control waiting
#   for and recycling connections.
# - Auth tokens: Replace JWT_SECRET_KEY with a strong secret. The other token
#   settings control the signing algorithm and token lifetimes.
# - Links and email: FRONTEND_BASE_URL is used to build password reset and
#   setup links. EMAIL_BACKEND=console writes those links to the server log
#   instead of sending email.